# ===== 共通（全リポジトリ。_templates/common/.gitignore と揃える） =====

# 依存パッケージ
node_modules/

# ログ
*.log
npm-debug.log*

# 環境変数（秘密情報）
.env
.env.*
!.env.example

# ローカル専用の設計資料・サンプル（.claude.local/ や *.local）
.claude.local/
*.local

# テスト
coverage/

# OS・エディタ
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# ===== リポジトリ固有（ビルド成果物などをこの下に書く） =====

# ビルド成果物
dist/
dist-ssr/
